# =============================================
# DEPTHGUARD - CONFIGURACION
# Copiar como .env:  copy .env.example .env   (Windows)
#                    cp .env.example .env     (Linux)
# =============================================
#
# AQUI NO HAY NINGUNA CONTRASENA. Antes este fichero traia
# ADMIN_PASSWORD=admin123, que ademas estaba publicada en el README de un
# repositorio publico: eso no es un valor por defecto, es una credencial
# conocida. Las credenciales de administrador no son cosa del edge.
#
# Los valores de abajo son los de DESARROLLO. Para desplegar de verdad, mira
# la seccion "PRODUCCION" del final: al arrancar, el sistema te dira que te
# falta.


# --- CAMARA ---
# simulada  = webcam, SIN profundidad. El anti-spoofing 3D no esta disponible
#             y la prueba de vida es solo 2D (parpadeo).
# realsense = Intel RealSense D400. Anti-spoofing 3D + liveness 2D.
MODO_CAMARA=simulada


# --- SUPABASE ---
SUPABASE_URL=

# Clave de DISPOSITIVO, restringida por RLS. Es la que debe usarse.
# Generala con supabase/rls_edge.sql.
SUPABASE_EDGE_KEY=

# Clave publica, para la senalizacion WebRTC (no toca ninguna tabla).
SUPABASE_ANON_KEY=

# LEGADO. La service_role key salta TODA la RLS: quien lea este fichero
# controlaria el proyecto entero, plantillas biometricas incluidas.
# Solo mientras migras.
SUPABASE_SERVICE_KEY=
PERMITIR_SERVICE_KEY=true


# --- ANTI-SPOOFING 3D (solo con RealSense) ---
UMBRAL_VARIANZA=0.7
UMBRAL_RANGO_PROF=3.0
UMBRAL_SUAVIDAD=5.0
RANGO_DIST_MIN=25
RANGO_DIST_MAX=150
MIN_PIXELES_VALIDOS=0.30


# --- PRUEBA DE VIDA (liveness 2D) ---
# Exigir camara con profundidad real para conceder accesos.
REQUERIR_CAMARA_3D=false
LIVENESS_PARPADEOS_REQUERIDOS=1
LIVENESS_TIMEOUT=12.0
# La deteccion de pantalla se REGISTRA pero no bloquea: sus umbrales dependen
# de tu camara y tu iluminacion. Recoge metricas reales antes de activarla.
LIVENESS_TEXTURA_BLOQUEA=false


# --- RECONOCIMIENTO ---
TOLERANCIA_FACIAL=0.50
# Separacion minima con la segunda mejor identidad. Subirlo = menos falsos
# positivos, mas "DESCONOCIDO".
MARGEN_IDENTIDAD=0.06
# Votacion temporal: un solo embedding nunca emite un evento.
VOTOS_VENTANA=5
VOTOS_REQUERIDOS=3
COOLDOWN_EMBEDDING=2.0
COOLDOWN_EMBEDDING_VOTACION=0.4
COOLDOWN_ANTISPOOFING=0.3
COOLDOWN_EVENTO=5
# Tope de embeddings por frame: acota el tiempo de frame con varias personas.
MAX_EMBEDDINGS_POR_FRAME=1


# --- ENROLAMIENTO BIOMETRICO ---
# Sobrescribir la biometria de alguien que ya la tiene es el vector de
# suplantacion. Dejalo en false y activalo solo el rato que dure un
# re-enrolamiento legitimo.
PERMITIR_REENROLAMIENTO=false
# Secreto para verificar comandos firmados. Firma EN SERVIDOR, nunca en el
# navegador. Vacio = sin firma.
REGISTRO_HMAC_SECRET=


# --- ALMACENAMIENTO DE CAPTURAS ---
# true = URLs firmadas que caducan. Antes de activarlo: (1) que el frontend
# lea preview_url de estado_sistema, (2) aplicar la seccion 4 del SQL.
STORAGE_PRIVADO=false


# --- RETENCION DE DATOS ---
DIAS_RETENCION=30
# Borrar el historial no deberia ser un privilegio del dispositivo.
# Con clave restringida: false, y programa la retencion con pg_cron.
CLEANUP_EN_EDGE=true


# --- WEBRTC / TURN ---
TURN_URL=turn:global.relay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=


# =============================================
# PRODUCCION
# =============================================
# Con true, cualquier hallazgo CRITICO o ALTO del informe de postura ABORTA el
# arranque en vez de imprimir un aviso que nadie lee.
MODO_PRODUCCION=false
#
# Configuracion objetivo para un despliegue real:
#
#   MODO_CAMARA=realsense
#   REQUERIR_CAMARA_3D=true
#   SUPABASE_EDGE_KEY=<clave restringida>
#   SUPABASE_ANON_KEY=<clave publica>
#   PERMITIR_SERVICE_KEY=false
#   STORAGE_PRIVADO=true
#   CLEANUP_EN_EDGE=false
#   PERMITIR_REENROLAMIENTO=false
#   REGISTRO_HMAC_SECRET=<secreto compartido con el servidor que firma>
#   MODO_PRODUCCION=true
#
# Y en el .env NO debe quedar ADMIN_USUARIO ni ADMIN_PASSWORD.
