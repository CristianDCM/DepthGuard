# =============================================
# DEPTHGUARD - CONFIGURACION
# Copiar como .env:  copy .env.example .env   (Windows)
#                    cp .env.example .env     (Linux)
# =============================================
#
# AQUI NO HAY NINGUNA CONTRASENA. Antes este fichero traia
# ADMIN_PASSWORD=admin123, que ademas estaba publicada en el README de un
# repositorio publico: eso no es un valor por defecto, es una credencial
# conocida. Las credenciales de administrador no son cosa del edge.
#
# Los valores de abajo son los de DESARROLLO. Para desplegar de verdad, mira
# la seccion "PRODUCCION" del final: al arrancar, el sistema te dira que te
# falta.


# --- CAMARA ---
# simulada  = webcam, SIN profundidad. El anti-spoofing 3D no esta disponible
#             y la prueba de vida es solo 2D (parpadeo).
# realsense = Intel RealSense D400. Anti-spoofing 3D + liveness 2D.
MODO_CAMARA=simulada

# Resolucion NATIVA que se le pide a la webcam (solo modo simulada).
#
# No es la resolucion a la que se detecta ni a la que se transmite: el
# pipeline reduce cada frame a 640 de ancho para detectar, para el preview y
# para WebRTC. El frame nativo lo usa un unico sitio, el recorte del que sale
# el embedding facial, y nunca sale de la maquina. Por eso subir esto NO
# aumenta el consumo de Storage ni el ancho de banda de Supabase.
#
# 1280x960 es el valor recomendado porque es exactamente 2x 640x480: el
# frame reducido queda identico al de una camara de 640, con el mismo
# encuadre, asi que los umbrales de calidad y de liveness siguen valiendo.
# A cambio, el recorte facial pasa de ~90x120 px a ~180x240 px reales.
#
# Bajalo a 640x480 si la camara no da mas; el sistema funciona igual, solo
# con menos detalle para el embedding (y al arrancar te avisara de ello).
CAMARA_ANCHO=1280
CAMARA_ALTO=960

# FPS que se le piden al driver. El pipeline se limita aparte a 20 FPS; este
# valor sirve sobre todo para detectar que la camara NO concedio lo pedido.
# Si al arrancar ves un ritmo real muy por debajo, la camara casi seguro
# negocio un formato sin comprimir que no cabe por USB: baja la resolucion.
CAMARA_FPS=30


# --- SUPABASE ---
SUPABASE_URL=

# Clave de DISPOSITIVO, restringida por RLS. Es la que debe usarse.
# Generala con supabase/rls_edge.sql.
SUPABASE_EDGE_KEY=

# Clave publica. OBLIGATORIA si usas SUPABASE_EDGE_KEY: la puerta de entrada
# de Supabase solo acepta la anon o la service_role en la cabecera `apikey`,
# y el token del edge viaja aparte en `Authorization`. Sin ella, 401.
# Tambien es la que usa la senalizacion WebRTC.
SUPABASE_ANON_KEY=

# LEGADO. La service_role key salta TODA la RLS: quien lea este fichero
# controlaria el proyecto entero, plantillas biometricas incluidas.
# Solo mientras migras.
SUPABASE_SERVICE_KEY=
PERMITIR_SERVICE_KEY=true


# --- ANTI-SPOOFING 3D (solo con RealSense) ---
UMBRAL_VARIANZA=0.7
UMBRAL_RANGO_PROF=3.0
UMBRAL_SUAVIDAD=5.0
RANGO_DIST_MIN=25
RANGO_DIST_MAX=150
MIN_PIXELES_VALIDOS=0.30


# --- PRUEBA DE VIDA (liveness 2D) ---
# Exigir camara con profundidad real para conceder accesos.
REQUERIR_CAMARA_3D=false
LIVENESS_PARPADEOS_REQUERIDOS=1
LIVENESS_TIMEOUT=12.0
# La deteccion de pantalla se REGISTRA pero no bloquea: sus umbrales dependen
# de tu camara y tu iluminacion. Recoge metricas reales antes de activarla.
LIVENESS_TEXTURA_BLOQUEA=false


# --- RECONOCIMIENTO ---
TOLERANCIA_FACIAL=0.50
# Separacion minima con la segunda mejor identidad. Subirlo = menos falsos
# positivos, mas "DESCONOCIDO".
MARGEN_IDENTIDAD=0.06
# Votacion temporal: un solo embedding nunca emite un evento.
VOTOS_VENTANA=5
VOTOS_REQUERIDOS=3
COOLDOWN_EMBEDDING=2.0
COOLDOWN_ANTISPOOFING=0.3
COOLDOWN_EVENTO=5

# Los dos siguientes tienen valor por defecto SEGUN EL MOTOR, porque el coste
# por rostro cambia en dos ordenes de magnitud (217 ms con dlib, 3-7 ms con
# onnx, medido en el equipo del edge). Dejalos COMENTADOS para que cada motor
# use el suyo; descomentalos solo si quieres forzar un valor.
#
#   MAX_EMBEDDINGS_POR_FRAME     dlib: 1     onnx: 5
#   COOLDOWN_EMBEDDING_VOTACION  dlib: 0.4   onnx: 0.2
#
# Con dlib el tope de 1 es obligatorio: 5 personas serian 1,1 s de frame. Con
# onnx los N rostros van en UNA sola inferencia (5 en 26 ms), asi que el tope
# de 1 no protegia de nada y solo retrasaba la identificacion de un grupo.
#
# Medido en el pipeline real, tiempo hasta identificar a 3 personas:
#   dlib, tope 1   ->  13 frames / 1,07 s
#   onnx, lote     ->   7 frames / 0,28 s
#COOLDOWN_EMBEDDING_VOTACION=0.4
#MAX_EMBEDDINGS_POR_FRAME=1


# --- ENROLAMIENTO BIOMETRICO ---
# Sobrescribir la biometria de alguien que ya la tiene es el vector de
# suplantacion. Dejalo en false y activalo solo el rato que dure un
# re-enrolamiento legitimo.
PERMITIR_REENROLAMIENTO=false
# Secreto para verificar comandos firmados. Firma EN SERVIDOR, nunca en el
# navegador. Vacio = sin firma.
REGISTRO_HMAC_SECRET=


# --- ALMACENAMIENTO DE CAPTURAS ---
# true = URLs firmadas que caducan. Antes de activarlo: (1) que el frontend
# lea preview_url de estado_sistema, (2) aplicar la seccion 4 del SQL.
STORAGE_PRIVADO=false


# --- MOTOR DE RECONOCIMIENTO FACIAL ---
#
# dlib = face_recognition, 128 dimensiones. Lo que hay hoy.
# onnx = MobileFaceNet entrenado con ArcFace, 512 dimensiones.
#
# Medido en el equipo del edge (16 nucleos, Windows):
#     dlib            217.5 ms por rostro
#     onnx  1 hilo      9.7 ms      22x mas rapido
#     onnx 16 hilos     3.2 ms      69x mas rapido
# Y onnx procesa las N caras de un frame en una sola pasada: 5 rostros en
# 26 ms, frente a los ~1090 ms que costarian con dlib uno detras de otro.
# Gasta ademas menos memoria (+32 MB frente a +92 MB) y arranca antes.
#
# CAMBIAR DE MOTOR INVALIDA TODAS LAS PLANTILLAS GUARDADAS. Son espacios
# distintos e incomparables, asi que hay que volver a registrar a todos los
# usuarios. El sistema detecta la mezcla, descarta las plantillas del otro
# motor y avisa al arrancar, en vez de comparar vectores incompatibles.
#
# Pasos para cambiar:
#   1. pip install onnxruntime
#   2. python scripts/descargar_modelo.py
#   3. MOTOR_EMBEDDING=onnx aqui
#   4. volver a registrar a los usuarios
#   5. python scripts/calibrar_umbral.py   <- IMPORTANTE, ver abajo
MOTOR_EMBEDDING=onnx

# Ruta del modelo. Por defecto scripts/_modelos/w600k_mbf.onnx, que es donde lo
# deja scripts/descargar_modelo.py.
#RUTA_MODELO_ONNX=

# Hilos internos de onnxruntime. 0 = que decida la libreria (usa los nucleos
# disponibles, es lo mas rapido). Ponlo a 1 o 2 si quieres dejar mas CPU libre
# para el resto del pipeline a cambio de unos ms mas por rostro.
ONNX_HILOS=0

# Umbral del motor ONNX. NO es el mismo que TOLERANCIA_FACIAL: este motor
# devuelve vectores de norma 1, asi que la distancia esta acotada en [0, 2].
# 1.095 equivale a exigir similitud coseno >= 0.40.
#
# Es una eleccion razonable de la literatura, NO una medida de tus rostros, tu
# camara y tu luz. Ejecuta scripts/calibrar_umbral.py con los usuarios ya
# registrados: compara las plantillas entre si y te dice que umbral separa
# "misma persona" de "personas distintas" en TU instalacion.
TOLERANCIA_FACIAL_ONNX=1.095
MARGEN_IDENTIDAD_ONNX=0.10
ESCALA_CONFIANZA_ONNX=0.12


# --- RETENCION DE DATOS ---
DIAS_RETENCION=30
# Borrar el historial no es un privilegio del dispositivo: un edge
# comprometido podria borrar el rastro de auditoria.
#
# Con la clave restringida esto NO PUEDE ser true aunque quieras: el edge no
# tiene permiso de lectura sobre historial, asi que la consulta que busca los
# registros caducados falla antes de borrar nada. Dejarlo en true solo
# produce un error cada 24 horas.
#
# La retencion la hace la base de datos, no el dispositivo: pg_cron invoca cada
# dia a las 07:00 UTC la Edge Function "retencion", que borra la FOTO primero y
# la FILA despues. Ya esta aplicado; ver supabase/retencion.sql.
#
# DIAS_RETENCION de aqui arriba solo afecta al cleanup del edge (desactivado).
# La ventana que se aplica de verdad es la de la Edge Function.
CLEANUP_EN_EDGE=false


# --- SENALIZACION WEBRTC ---
# true = canal privado (la RLS decide quien puede pedir video). Antes de
# activarlo: (1) aplicar supabase/rls_realtime.sql, (2) en el frontend
# setAuth() + { config: { private: true } }.
WEBRTC_CANAL_PRIVADO=false
# Tope de conexiones simultaneas (cada una consume CPU de codificacion).
WEBRTC_MAX_CONEXIONES=3

# --- WEBRTC / TURN ---
TURN_URL=turn:global.relay.metered.ca:80
TURN_USERNAME=
TURN_CREDENTIAL=


# =============================================
# PRODUCCION
# =============================================
# Con true, cualquier hallazgo CRITICO o ALTO del informe de postura ABORTA el
# arranque en vez de imprimir un aviso que nadie lee.
MODO_PRODUCCION=false
#
# Configuracion objetivo para un despliegue real:
#
#   MODO_CAMARA=realsense
#   REQUERIR_CAMARA_3D=true
#   SUPABASE_EDGE_KEY=<clave restringida>
#   SUPABASE_ANON_KEY=<clave publica>
#   PERMITIR_SERVICE_KEY=false
#   STORAGE_PRIVADO=true
#   CLEANUP_EN_EDGE=false
#   PERMITIR_REENROLAMIENTO=false
#   REGISTRO_HMAC_SECRET=<secreto compartido con el servidor que firma>
#   WEBRTC_CANAL_PRIVADO=true
#   MODO_PRODUCCION=true
#
# Y en el .env NO debe quedar ADMIN_USUARIO ni ADMIN_PASSWORD.
